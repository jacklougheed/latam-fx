# systemd unit for LatamFX. Copy to /etc/systemd/system/latamfx.service,
# adjust paths/users, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now latamfx
#
# Assumes Node was installed via NodeSource (node + npm at /usr/bin).
# If you use nvm, set ExecStart to the absolute path from `which node`.

[Unit]
Description=LatamFX (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/latamfx
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SITE_URL=https://latamfx.com
Environment=DATA_DIR=/var/www/latamfx/data
Environment=REFRESH_INTERVAL_MINUTES=30
# Environment=REFRESH_SECRET=change-me-to-a-long-random-string
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

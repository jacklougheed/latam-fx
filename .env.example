# Public base URL of the site — used for canonical URLs, sitemap and hreflang tags.
SITE_URL=https://latam-fx.com

# Where the rate history JSON is stored on disk (defaults to ./data).
DATA_DIR=./data

# How often rates refresh in the background, in minutes (minimum 5, default 30).
REFRESH_INTERVAL_MINUTES=30

# Optional shared secret to protect POST/GET /api/refresh.
# Leave blank to allow open manual refreshes; set a value in production.
REFRESH_SECRET=
